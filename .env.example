# Production Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your-secure-mongodb-password
REDIS_PASSWORD=your-secure-redis-password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# API Security
API_KEY_SALT=your-api-key-salt-min-32-chars
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-min-32-chars

# Application Configuration
FRONTEND_URL=https://your-domain.com
VITE_API_BASE_URL=https://your-domain.com/api/v1
VITE_SOCKET_URL=https://your-domain.com
VITE_APP_NAME=WhatsApp Integration
VITE_APP_VERSION=1.0.0

# WPPConnect Configuration
WPP_MAX_CLIENTS=50

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=12

# SSL Configuration (if using HTTPS)
SSL_CERT_PATH=/path/to/your/cert.pem
SSL_KEY_PATH=/path/to/your/private.key