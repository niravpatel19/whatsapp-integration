# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/whatsapp-integration
MONGODB_TEST_URI=mongodb://localhost:27017/whatsapp-integration-test

# Redis Configuration
REDIS_URL=redis://localhost:6369
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Key Configuration
API_KEY_SALT=your-api-key-salt-change-this-in-production

# Webhook Configuration
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret-change-this

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_MAX_REQUESTS_PER_ENDPOINT_MESSAGES=30
RATE_LIMIT_MAX_REQUESTS_PER_ENDPOINT_SESSIONS=10

# WPPConnect Configuration
WPP_SESSION_PATH=./sessions
WPP_MAX_CLIENTS=50
WPP_HEADLESS=true
WPP_DEVTOOLS=false

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-change-this

# Webhook Retry Configuration
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY=1000
WEBHOOK_TIMEOUT=30000

# File Upload Configuration
MAX_FILE_SIZE=100MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,video/mp4

# Performance Configuration
DB_CONNECTION_POOL_MIN=5
DB_CONNECTION_POOL_MAX=20
REDIS_CONNECTION_POOL_MIN=5
REDIS_CONNECTION_POOL_MAX=20