{
  "name": "whatsapp-integration-backend",
  "version": "1.0.0",
  "description": "Backend API for WhatsApp Integration service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "build:prod": "NODE_ENV=production tsc && tsc-alias -p tsconfig.json",
    "start": "NODE_ENV=production node dist/server.js",
    "start:dev": "NODE_ENV=development node dist/server.js",
    "verify-env": "node verify-env.js",
    "create-user": "ts-node -r tsconfig-paths/register src/scripts/create-default-user.ts",
    "whatsapp:enable": "ts-node src/scripts/toggle-whatsapp.ts real",
    "whatsapp:disable": "ts-node src/scripts/toggle-whatsapp.ts stub",
    "whatsapp:real": "ts-node src/scripts/toggle-whatsapp.ts real",
    "whatsapp:stub": "ts-node src/scripts/toggle-whatsapp.ts stub",
    "test:whatsapp": "ts-node -r tsconfig-paths/register src/scripts/test-whatsapp-flow.ts",
    "recover-session": "ts-node -r tsconfig-paths/register src/scripts/recover-expired-session.ts",
    "monitor-sessions": "ts-node -r tsconfig-paths/register src/scripts/monitor-sessions.ts",
    "prevent-expiration": "ts-node -r tsconfig-paths/register src/scripts/prevent-session-expiration.ts",
    "fix-session-info": "ts-node -r tsconfig-paths/register src/scripts/fix-session-info.ts",
    "fix-phone-numbers": "ts-node -r tsconfig-paths/register src/scripts/fix-phone-numbers.ts",
    "quick-start": "ts-node src/scripts/quick-start.ts quick && npm run dev",
    "normal-start": "ts-node src/scripts/quick-start.ts normal && npm run dev",
    "optimize-sessions": "ts-node src/scripts/optimize-sessions.ts",
    "test-session": "ts-node -r tsconfig-paths/register src/scripts/test-session-creation.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@wppconnect-team/wppconnect": "^1.37.3",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "redis": "^5.8.1",
    "socket.io": "^4.7.4",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
