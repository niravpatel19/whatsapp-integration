# Production Environment Configuration
# Backend Environment Variables
# Copy this file to .env.production and update values for production

# Server Configuration
NODE_ENV=production
PORT=7811
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/whatsapp-integration-prod
MONGODB_OPTIONS={"maxPoolSize":10,"serverSelectionTimeoutMS":5000,"socketTimeoutMS":45000}

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration - CHANGE THESE IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
CORS_ORIGIN=http://82.29.198.95:7810

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WhatsApp Configuration
WHATSAPP_MODE=real
WHATSAPP_SESSION_PATH=./sessions

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Performance
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# Feature Flags
ENABLE_SWAGGER=false
ENABLE_DEBUG_LOGS=false 