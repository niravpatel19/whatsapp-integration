        {
          "name": "Test Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payload\": {\n    \"test\": true,\n    \"message\": \"This is a test webhook from Postman\",\n    \"timestamp\": \"{{$isoTimestamp}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/{{webhook_id}}/test",
              "host": ["{{base_url}}"],
              "path": ["webhooks", "{{webhook_id}}", "test"]
