        {
          "name": "List Webhooks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/webhooks?includeInactive=false",
              "host": ["{{base_url}}"],
              "path": ["webhooks"],
              "query": [
                {
                  "key": "includeInactive",
                  "value": "false"
                }
              ]
            },
            "description": "Get all webhooks for the authenticated user"
          },
          "response": []
        },
        {
          "name": "Create Webhook",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
