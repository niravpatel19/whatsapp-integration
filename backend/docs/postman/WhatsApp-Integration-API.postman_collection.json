  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set base URL based on environment",
          "if (pm.environment.get('environment') === 'production') {",
          "    pm.collectionVariables.set('base_url', 'https://api.whatsapp-integration.com/api/v1');",
          "} else {",
          "    pm.collectionVariables.set('base_url', 'http://localhost:7811/api/v1');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test to check response time",
          "pm.test('Response time is less than 5000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Global test to check for proper error format",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error response has proper format', function () {",
          "        const response = pm.response.json();",
          "        pm.expect(response).to.have.property('error');",
          "        pm.expect(response.error).to.have.property('code');",
          "        pm.expect(response.error).to.have.property('message');",
          "    });",
          "}"
        ]
      }
    }
  ]
}