          "name": "Get Webhook Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/webhooks/{{webhook_id}}/logs?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["webhooks", "{{webhook_id}}", "logs"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Get webhook delivery logs"
